{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "0.1.0",
  "description": "DeepSeek Harness 桌面客户端 — 双击即可启动的 DSH Web UI 外壳，无需命令行",
  "main": "main.cjs",
  "private": true,
  "license": "MIT",
  "author": "DSH Desktop",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "pack": "electron-builder --win --x64",
    "dist": "electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.deepseekai.dshdesktop",
    "productName": "DSH Desktop",
    "asar": false,
    "npmRebuild": false,
    "compression": "normal",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "package.json",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "runtime/node.exe",
        "to": "runtime/node.exe"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Desktop",
      "artifactName": "DSH-Desktop-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DSH-Desktop-Portable-${version}.${ext}"
    }
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.1.0-rc.6": true,
    "@google/genai@1.52.0": true,
    "electron-winstaller@5.4.0": true,
    "koffi@3.1.5": true,
    "node-pty@1.1.0": true,
    "protobufjs@7.6.5": true
  }
}
